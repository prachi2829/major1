# Copy to backend/.env. Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public backend/frontend origins. Must match provider callback URLs exactly.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Generate a Fernet key once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key private and persistent. Losing it makes stored OAuth tokens unreadable.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Meta developer app: one OAuth app is used for Facebook Pages and Instagram Professional accounts.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v27.0

# LinkedIn developer app. OAuth scopes: openid profile w_member_social.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601

# X developer app configured for OAuth 2.0 Authorization Code with PKCE and confidential client.
# Required scopes: tweet.read tweet.write users.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
