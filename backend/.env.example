# Copy this file to .env in the backend folder and paste your keys.
# Gemini API Key (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Twitter / X API v2 (https://developer.twitter.com) ──
TWITTER_BEARER_TOKEN=

# ── LinkedIn API (https://developer.linkedin.com) ──
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:12345678

# ── Meta Graph API (Instagram & Facebook - https://developers.facebook.com) ──
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
